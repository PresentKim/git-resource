{
  "functions": {
    "api/og.tsx": {
      "includeFiles": "api/_fonts/**"
    }
  },
  "headers": [
    {
      "source": "/proxy/raw-auth/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/proxy/raw-auth/:path*",
      "destination": "https://raw.githubusercontent.com/:path*"
    },
    {
      "source": "/proxy/github/:path*",
      "destination": "https://github.com/:path*"
    },
    {
      "source": "/proxy/raw/:path*",
      "destination": "https://raw.githubusercontent.com/:path*"
    },
    {
      "source": "/proxy/codeload/:path*",
      "destination": "https://codeload.github.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
