    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.555.0",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^3.6.2",
